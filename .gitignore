# ===== Large regenerable experiment outputs (kept local) =====
# Parquet / bulk inference payloads exceed GitHub size limits or are
# regenerable from frozen caches; tables/figures/manifests stay versioned.
artifacts/experiments/**/*.parquet
artifacts/experiment/full_development_inputs_v1/M1_V2_FULL_DEVELOPMENT_INFERENCE_INPUTS.json

# ===== Over-100MB regenerable artifacts (GitHub hard limit, kept local) =====
# Exp2A full-development joint/marginal CSV dumps (~330-360MB) and M2
# full-development consequences parquet (~313MB) exceed GitHub's 100MB hard
# limit; small point/variogram tables & manifests remain versioned.
artifacts/experiment/exp2/exp2_representation_refactor_20260825/EXP2A_JOINT_RECORDS_DEVELOPMENT_ONLY.csv
artifacts/experiment/exp2/exp2_representation_refactor_20260825/EXP2A_MARGINAL_RECORDS_DEVELOPMENT_ONLY.csv
artifacts/paper_results_v1/exp2/M2_FULL_DEVELOPMENT_CONSEQUENCES.parquet

# ===== Over-100MB Final Test RMB regenerable artifact (GitHub hard limit) =====
# M2 Final Test consequences parquet (~304MB) exceeds GitHub's 100MB hard
# limit; regenerable from the frozen Final Test input & lineage caches.
artifacts/paper_results_v2_final_test_rmb/exp2/M2_FINAL_TEST_CONSEQUENCES.parquet

# ===== Over-100MB regenerable passenger-reference freeze (GitHub hard limit) =====
# T100 expected-pax-per-flight reference JSON (~312MB) exceeds GitHub's 100MB
# hard limit; regenerable via the passenger-reference freeze materialization
# pipeline (see materialization.log / PASSENGER_REFERENCE_MANIFEST.json).
artifacts/diagnostics/passenger_reference_freeze/T100_EXPECTED_PAX_PER_FLIGHT_REFERENCE.json

